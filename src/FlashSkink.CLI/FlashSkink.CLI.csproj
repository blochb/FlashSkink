<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Binary name: both the published executable and the displayed usage line read "skink". -->
    <AssemblyName>skink</AssemblyName>
    <RootNamespace>FlashSkink.CLI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlashSkink.Core\FlashSkink.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Formatting.Compact" />
  </ItemGroup>

  <!-- Setup-guide embedded resources. Explicit LogicalName values so SetupGuideResources
       can look them up by a stable key regardless of directory naming conventions. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\setup-guides\google-drive.txt">
      <LogicalName>guides.google-drive</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\setup-guides\dropbox.txt">
      <LogicalName>guides.dropbox</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\setup-guides\onedrive.txt">
      <LogicalName>guides.onedrive</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\setup-guides\filesystem.txt">
      <LogicalName>guides.filesystem</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
